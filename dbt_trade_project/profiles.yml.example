trade_pipeline:
  target: dev
  outputs:
    dev:
      type: snowflake
      account: "{{ env_var('SNOWFLAKE_ACCOUNT') }}"
      user: "{{ env_var('SNOWFLAKE_USER') }}"
      password: "{{ env_var('SNOWFLAKE_PASSWORD') }}"
      role: "{{ env_var('SNOWFLAKE_ROLE', 'TRADE_PIPELINE_ROLE') }}"
      database: "{{ env_var('SNOWFLAKE_DATABASE', 'TRADE_DB') }}"
      warehouse: "{{ env_var('SNOWFLAKE_WAREHOUSE', 'TRADE_WH') }}"
      schema: DBT
      threads: 4
